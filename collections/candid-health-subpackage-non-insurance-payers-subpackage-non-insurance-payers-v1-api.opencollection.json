        {
          "info": {
            "name": "Get non-insurance payer categories",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://pre-api.joincandidhealth.com/api/non-insurance-payers/v1/categories",
            "headers": [
