                "value": ""
              }
            ],
            "params": [
              {
                "name": "search_term",
                "value": "",
                "type": "query",
                "description": "Filters categories by fuzzy matching on name."
              },
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Limits the maximum number of categories that will be returned. Defaults to 100."
              },
              {
                "name": "page_token",
                "value": "",
                "type": "query",
                "description": "The page token to continue paging through a previous request."
              }
            ]
          },
          "docs": "Returns a paginated list of all non-insurance payer categories.\n\nNon-insurance payer categories are simply strings and are not stored as a\nseparate object in Candid. They are created when added to at least one\nnon-insurance payer's `category` field and are deleted when there are no\nlonger any non-insurance payers that contain them."
        },
