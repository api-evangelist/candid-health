      "items": [
        {
          "info": {
            "name": "Get Match",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://pre-api.joincandidhealth.com/api/fee-schedules/v3/service-line/:service_line_id/match",
            "headers": [
              {
                "name": "Authorization",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "service_line_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Gets the rate that matches a service line.  No result means no rate exists matching the service line's dimensions."
        },
        {
          "info": {
            "name": "Test Match",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://pre-api.joincandidhealth.com/api/fee-schedules/v3/service-line/:service_line_id/match/:rate_id",
